# Copy to .env.local for local overrides. In CI, set these as GitHub repository
# variables (Settings → Secrets and variables → Actions → Variables) instead.

# Absolute public URL of the deployed site (used for canonical + Open Graph URLs).
VITE_SITE_URL=https://mentoros-62.github.io/mentoros-website/

# Where CTAs send people. Leave a form URL empty to fall back to email (mailto:).
VITE_CONTACT_EMAIL=mentoros.support@gmail.com
VITE_PILOT_FORM_URL=
VITE_EARLY_ACCESS_FORM_URL=
